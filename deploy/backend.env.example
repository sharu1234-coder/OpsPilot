# OpsPilot production backend environment template
#
# This file contains no secrets.
# Do not put production credentials in this repository.
#
# On Ubuntu, create the real configuration at:
# /etc/opspilot/backend.env
#
# Protect it with:
# owner: root
# group: opspilot
# permissions: 0640
#
# Replace the empty values before starting the service.

# Production mode enables secure session cookies.
ENVIRONMENT=production

# Required: production PostgreSQL connection URL.
# Example format (not a real credential):
# postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
#
# URL-encode special characters in credentials.
# Configure PostgreSQL TLS as required by your database host.
DATABASE_URL=

# Required: public HTTPS origin of the React frontend.
# Must match the browser Origin exactly.
# Example: https://opspilot.example.com
# Do not include a trailing slash.
TRUSTED_ORIGINS=
